:global AddressList
:global ForwardTo
/ip dns static
:if ([:len [find name="a2asimulations.com"]] = 0) do={ add address-list=$AddressList forward-to=$ForwardTo comment="category-flight-simulator" match-subdomain=yes type=FWD name="a2asimulations.com" }
