:global AddressList
:global ForwardTo
/ip dns static
:if ([:len [find name="adash-c.m.taobao.com"]] = 0) do={ add address-list=$AddressList forward-to=$ForwardTo comment="alibaba@telemetry" match-subdomain=yes type=FWD name="adash-c.m.taobao.com" }
